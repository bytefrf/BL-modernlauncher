<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net8.0 без -windows: этот проект собирается и запускается на Windows, Linux и macOS. -->
    <TargetFramework>net8.0</TargetFramework>
    <Version>1.3.2</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>Launcher.Avalonia</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ветка 11.3 выбрана намеренно вместо 12.x: она обкатана и её поведение предсказуемо.
         Переход на 12 возможен позже, отдельным шагом. -->
    <PackageReference Include="Avalonia" Version="11.3.18" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.18" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.18" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.18" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.18" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Launcher.Core\Launcher.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ресурсы, которые раньше жили в Launcher.App. Иконка и фон нужны окну, скриншоты —
         карточкам сборок. -->
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

</Project>
