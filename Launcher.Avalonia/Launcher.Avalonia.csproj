<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net8.0 без -windows: этот проект собирается и запускается на Windows, Linux и macOS. -->
    <TargetFramework>net8.0</TargetFramework>
    <Version>1.3.3</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>Launcher.Avalonia</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ветка 11.3 выбрана намеренно вместо 12.x: она обкатана и её поведение предсказуемо.
         Переход на 12 возможен позже, отдельным шагом. -->
    <PackageReference Include="Avalonia" Version="11.3.18" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.18" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.18" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.18" />
  </ItemGroup>

  <ItemGroup>
    <!-- ICU В КОМПЛЕКТЕ ДЛЯ LINUX.
         На чистой Ubuntu .NET падает ещё до появления окна: «Couldn't find a valid ICU package».
         Проверено живьём — игрок увидел бы мгновенный выход без единого сообщения.
         Системный libicu ставить нельзя (это зависимость дистрибутива, а лаунчер — портативный),
         а InvariantGlobalization сломал бы сравнение и регистр кириллицы. Поэтому ICU кладётся
         внутрь пакета. На Windows и macOS ICU есть в системе всегда — там пакет не нужен. -->
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3"
                      Condition="$(RuntimeIdentifier.StartsWith('linux'))" />
  </ItemGroup>

  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux'))">
    <!-- Версия обязана совпадать с ПОЛНОЙ версией пакета выше: .NET ищет файл
         libicudata.so.<значение>, а он называется libicudata.so.72.1.0.3.
         Со значением «72.1» приложение падало с «Failed to load app-local ICU». -->
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" Trim="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.18" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Launcher.Core\Launcher.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ресурсы, которые раньше жили в Launcher.App. Иконка и фон нужны окну, скриншоты —
         карточкам сборок. -->
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

</Project>
