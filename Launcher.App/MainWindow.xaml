<Window x:Class="Launcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Forge Launcher"
        Icon="/Sprite-0001.png"
        Height="820"
        Width="1360"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        StateChanged="Window_StateChanged"
        SizeChanged="Window_SizeChanged"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0E1612" />
        <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#F3131C18" />
        <SolidColorBrush x:Key="TitleBarBorderBrush" Color="#325345" />
        <SolidColorBrush x:Key="WindowIconBackgroundBrush" Color="#294036" />
        <SolidColorBrush x:Key="WindowIconBorderBrush" Color="#6F9F86" />
        <SolidColorBrush x:Key="PanelBrush" Color="#18261F" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#21342A" />
        <SolidColorBrush x:Key="CardBrush" Color="#D01A2821" />
        <SolidColorBrush x:Key="CardAltBrush" Color="#CC111C19" />
        <SolidColorBrush x:Key="StrokeBrush" Color="#5E8A73" />
        <SolidColorBrush x:Key="MutedBrush" Color="#C9D6C8" />
        <SolidColorBrush x:Key="TextBrush" Color="#FFF7EA" />
        <SolidColorBrush x:Key="AccentBrush" Color="#E0B24F" />
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#B9802A" />
        <SolidColorBrush x:Key="TextBoxBackgroundBrush" Color="#E1141F1A" />
        <SolidColorBrush x:Key="TextBoxBorderBrush" Color="#5B8A72" />
        <SolidColorBrush x:Key="SoftButtonBackgroundBrush" Color="#355545" />
        <SolidColorBrush x:Key="SoftButtonBorderBrush" Color="#6B9A7F" />
        <SolidColorBrush x:Key="SoftButtonHoverBrush" Color="#456D5A" />
        <SolidColorBrush x:Key="SoftButtonPressedBrush" Color="#294236" />
        <SolidColorBrush x:Key="SocialButtonBackgroundBrush" Color="#3E6452" />
        <SolidColorBrush x:Key="SocialButtonBorderBrush" Color="#7DA78E" />
        <SolidColorBrush x:Key="SocialButtonHoverBrush" Color="#507D67" />
        <SolidColorBrush x:Key="IconButtonBackgroundBrush" Color="#355545" />
        <SolidColorBrush x:Key="IconButtonBorderBrush" Color="#6B9A7F" />
        <SolidColorBrush x:Key="IconButtonHoverBrush" Color="#456D5A" />
        <SolidColorBrush x:Key="TitleBarButtonHoverBrush" Color="#344E41" />
        <SolidColorBrush x:Key="TitleBarButtonPressedBrush" Color="#23372D" />
        <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="#F5D07A" />
        <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="#F0C96A" />

        <!-- Стеклянные (glassmorphism) ресурсы: полупрозрачная заливка, светлая грань сверху, мягкая тень.
             Нейтральны к теме — сквозь них читается фон-слайдшоу, а цветовые акценты дают тема и кнопки. -->
        <LinearGradientBrush x:Key="GlassFillBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#C42B3B32" Offset="0" />
            <GradientStop Color="#E6111A16" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassStrokeBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#5CFFFFFF" Offset="0" />
            <GradientStop Color="#15FFFFFF" Offset="1" />
        </LinearGradientBrush>
        <!-- Меню истории ников: системный ContextMenu светлый и выбивается из оформления. -->
        <Style x:Key="ThemedContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border CornerRadius="12" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <StackPanel IsItemsHost="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemedMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Root" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SoftButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DropShadowEffect x:Key="GlassShadow" BlurRadius="20" ShadowDepth="0" Color="#000000" Opacity="0.42" RenderingBias="Performance" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="Background" Value="{DynamicResource TextBoxBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TextBoxBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource TitleBarButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource TitleBarButtonPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SoftButton" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SoftButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SoftButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                CornerRadius="16"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SoftButtonHoverBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource SoftButtonBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SoftButtonPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SoftButton}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
            <Setter Property="Foreground" Value="#251907" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                CornerRadius="18"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PrimaryButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentDarkBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SocialButton" TargetType="Button" BasedOn="{StaticResource SoftButton}">
            <Setter Property="Height" Value="56" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SocialButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SocialButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                CornerRadius="20"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16"
                                                  ShadowDepth="0"
                                                  Color="#5A000000"
                                                  Opacity="0.45" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SocialButtonHoverBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource SocialButtonBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SoftButtonPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Строка-ссылка в кабинете: спокойная плитка вместо крупной цветной «таблетки» -->
        <Style x:Key="LinkRowButton" TargetType="Button">
            <Setter Property="Height" Value="46" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                CornerRadius="12"
                                Background="{DynamicResource CardAltBrush}"
                                BorderBrush="{DynamicResource StrokeBrush}"
                                BorderThickness="1"
                                Padding="12,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SoftButtonHoverBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SoftButtonPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource IconButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource IconButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                CornerRadius="14"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource IconButtonHoverBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource IconButtonBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SoftButtonPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="13"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SoftButtonHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DropdownToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource GlassFillBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlassStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root" CornerRadius="14"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PanelAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PanelAltBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemedScrollPageButton" TargetType="RepeatButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Border CornerRadius="5" Margin="3,2" Opacity="0.45"
                                    Background="{DynamicResource CardAltBrush}" />
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ThemedScrollPageButton}" Command="ScrollBar.PageUpCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ThemedScrollPageButton}" Command="ScrollBar.PageDownCommand" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="ThumbControl" Background="{DynamicResource StrokeBrush}">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="5" Margin="3,0"
                                                        Background="{TemplateBinding Background}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbControl" Property="Background" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto" />
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="Height" Value="10" />
                                <Setter Property="MinHeight" Value="10" />
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource TitleBarBackgroundBrush}"
                BorderBrush="{DynamicResource TitleBarBorderBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="14,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="24" Height="24" CornerRadius="6" Background="{DynamicResource WindowIconBackgroundBrush}" BorderBrush="{DynamicResource WindowIconBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                    <Image Width="18" Height="18" Source="/Sprite-0001.png" Stretch="Uniform" />
                </Border>
                <TextBlock x:Name="WindowTitleTextBlock" Grid.Column="2" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="TerraFirmaGreg Modern" />
                <Button Grid.Column="3" Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click" Content="-" />
                <Button Grid.Column="5" Style="{StaticResource TitleBarButton}" Click="CloseButton_Click" Content="X" />
            </Grid>
        </Border>

        <Grid x:Name="MainBackgroundGrid" Grid.Row="1">
        <Rectangle x:Name="BackgroundLayerA"
                   Opacity="1"
                   RenderOptions.BitmapScalingMode="LowQuality">
            <Rectangle.Fill>
                <ImageBrush x:Name="BackgroundImageBrushA"
                            Stretch="UniformToFill"
                            AlignmentX="Center"
                            AlignmentY="Center"
                            RenderOptions.CachingHint="Cache" />
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="BackgroundLayerB"
                   Opacity="0"
                   RenderOptions.BitmapScalingMode="LowQuality">
            <Rectangle.Fill>
                <ImageBrush x:Name="BackgroundImageBrushB"
                            Stretch="UniformToFill"
                            AlignmentX="Center"
                            AlignmentY="Center"
                            RenderOptions.CachingHint="Cache" />
            </Rectangle.Fill>
        </Rectangle>

        <Rectangle Fill="#42101712" />
        <Rectangle>
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.18,0.08" RadiusX="0.95" RadiusY="0.85">
                    <GradientStop Color="#1A4A3D2B" Offset="0" />
                    <GradientStop Color="#3C101712" Offset="0.68" />
                    <GradientStop Color="#86111914" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Margin="22,16,22,16">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border CornerRadius="30" Background="Transparent" BorderThickness="0" Padding="26,18,26,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- ВЕРХНЯЯ ПАНЕЛЬ В ОДИН УРОВЕНЬ: сборка + вкладки слева, поддержка + настройки справа -->
                    <Grid Grid.Row="0">
                        <!-- Слева вплотную друг к другу: название сборки и вкладки. Всё свободное место
                             забирает распорка (колонка 3), поэтому действия прижаты к правому краю, а
                             название — к левому. MaxWidth на КОЛОНКЕ, а не на кнопке: иначе при широком
                             окне Stretch+MaxWidth центрирует кнопку и название отъезжает от края.
                             Сжимается при этом именно колонка 0 (до MinWidth), вкладки и кнопки справа
                             имеют фиксированный размер, и раньше при узком окне их срезало по краю. -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="140" MaxWidth="300" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="16" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Вкладки собраны в один сегментированный блок, чтобы не путались с
                             кнопками-действиями справа (Моды/Поддержка/Настройки). -->
                        <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="17" Padding="4"
                                Background="{DynamicResource CardAltBrush}"
                                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="HomeTabButton" Style="{StaticResource TabButton}" Margin="0,0,4,0"
                                        Click="HomeTab_Click" Content="Главная" />
                                <Button x:Name="AccountTabButton" Style="{StaticResource TabButton}"
                                        Click="AccountTab_Click" Content="Личный кабинет" />
                            </StackPanel>
                        </Border>

                        <Grid Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Grid x:Name="ModpackDropdownHost" Visibility="Collapsed" HorizontalAlignment="Left">
                                <ToggleButton x:Name="ModpackDropdownButton" Style="{StaticResource DropdownToggle}"
                                              HorizontalAlignment="Left">
                                    <DockPanel LastChildFill="True">
                                        <Path DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,2,0,0"
                                              Data="M0,0 L10,0 L5,6 Z" Fill="{DynamicResource AccentBrush}" />
                                        <TextBlock x:Name="ModpackDropdownText" Text="Выбор сборки" FontSize="17" FontWeight="Bold"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextBrush}" />
                                    </DockPanel>
                                </ToggleButton>
                                <Popup x:Name="ModpackPopup" PlacementTarget="{Binding ElementName=ModpackDropdownButton}"
                                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                                       IsOpen="{Binding IsChecked, ElementName=ModpackDropdownButton, Mode=TwoWay}">
                                    <Border Width="430" Margin="0,6,0,0" CornerRadius="16"
                                            Background="{DynamicResource PanelBrush}"
                                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Padding="10">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="26" ShadowDepth="0" Color="#80000000" Opacity="0.55" />
                                        </Border.Effect>
                                        <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="ModpackListPanel">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <!-- Карточка сборки: обложка, описание, статус установки и наигранное время -->
                                                        <Button Click="ModpackItem_Click" Tag="{Binding Id}"
                                                                Margin="0,0,0,8" HorizontalContentAlignment="Stretch" Cursor="Hand">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="CardRoot" CornerRadius="14"
                                                                            Background="{Binding BackgroundBrush}"
                                                                            BorderBrush="{Binding BorderBrushColor}"
                                                                            BorderThickness="1" Padding="10">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="12" />
                                                                                <ColumnDefinition Width="*" />
                                                                            </Grid.ColumnDefinitions>

                                                                            <Border Width="52" Height="52" CornerRadius="12" VerticalAlignment="Top"
                                                                                    Background="{DynamicResource CardAltBrush}"
                                                                                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                                                                                    ClipToBounds="True">
                                                                                <Grid>
                                                                                    <TextBlock Text="{Binding InitialLetter}" FontSize="22" FontWeight="Bold"
                                                                                               Foreground="{DynamicResource AccentBrush}"
                                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                                    <Image Source="{Binding IconSource}" Stretch="UniformToFill"
                                                                                           Visibility="{Binding IconVisibility}" />
                                                                                </Grid>
                                                                            </Border>

                                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold"
                                                                                           Foreground="{DynamicResource TextBrush}"
                                                                                           TextTrimming="CharacterEllipsis" />
                                                                                <TextBlock Text="{Binding Description}" FontSize="11" Margin="0,3,0,0"
                                                                                           Foreground="{DynamicResource MutedBrush}"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           Visibility="{Binding DescriptionVisibility}" />
                                                                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                                                                    <Border CornerRadius="8" Padding="8,3"
                                                                                            Background="{DynamicResource CardAltBrush}"
                                                                                            Visibility="{Binding StatusVisibility}">
                                                                                        <StackPanel Orientation="Horizontal">
                                                                                            <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                                                                     Fill="{Binding StatusBrush}" />
                                                                                            <TextBlock Text="{Binding StatusText}" Margin="6,0,0,0"
                                                                                                       FontSize="10" FontWeight="SemiBold"
                                                                                                       Foreground="{Binding StatusBrush}" />
                                                                                        </StackPanel>
                                                                                    </Border>
                                                                                    <TextBlock Text="{Binding PlaytimeText}" Margin="8,0,0,0" FontSize="10"
                                                                                               VerticalAlignment="Center"
                                                                                               Foreground="{DynamicResource MutedBrush}"
                                                                                               Visibility="{Binding PlaytimeVisibility}" />
                                                                                </StackPanel>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="CardRoot" Property="Background"
                                                                                    Value="{DynamicResource SoftButtonHoverBrush}" />
                                                                            <Setter TargetName="CardRoot" Property="BorderBrush"
                                                                                    Value="{DynamicResource AccentBrush}" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <TextBlock x:Name="ServerTitleTextBlock" FontSize="26" FontWeight="Bold"
                                       VerticalAlignment="Center" HorizontalAlignment="Left"
                                       TextTrimming="CharacterEllipsis"
                                       Text="TerraFirmaGreg Modern" />
                        </Grid>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <!-- Разделитель: слева навигация по лаунчеру, справа — действия. -->
                            <Rectangle Width="1" Height="26" Margin="0,0,12,0" VerticalAlignment="Center"
                                       Fill="{DynamicResource StrokeBrush}" Opacity="0.7" />
                            <Button x:Name="OptionalModsButton" Width="94" Margin="0,0,8,0" Style="{StaticResource SoftButton}"
                                    Click="OptionalModsButton_Click" Content="Моды" Visibility="Collapsed"
                                    ToolTip="Дополнительные моды, одобренные администрацией" />
                            <Button x:Name="SupportButton" Width="118" Margin="0,0,8,0" Style="{StaticResource SoftButton}"
                                    Click="SupportButton_Click" Content="Поддержка" ToolTip="Написать в поддержку" />
                            <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Click="SettingsButton_Click" ToolTip="Настройки">
                                <Image Width="24" Height="24" Source="/Sprite-0002.png" Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- ОФЛАЙН-ПОЛОСА: сайт недоступен, работаем на сохранённых данных.
                         Раньше об этом не говорилось ничего, и устаревшие данные выглядели
                         как случайный сбой. -->
                    <Border x:Name="OfflineBanner" Grid.Row="2" VerticalAlignment="Top" Margin="0,0,0,12"
                            CornerRadius="14" Padding="14,10" Visibility="Collapsed" Panel.ZIndex="5"
                            Background="{DynamicResource CardAltBrush}"
                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontSize="15"
                                       Foreground="{DynamicResource AccentBrush}" Text="⚠" />
                            <TextBlock x:Name="OfflineBannerText" Grid.Column="2" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextBrush}" />
                        </Grid>
                    </Border>

                    <!-- ТЕЛО: вкладки «Главная» и «Личный кабинет» -->
                    <Grid Grid.Row="2">
                      <Grid x:Name="HomePage">
                        <!-- Колонки резиновые: при фиксированной ширине (было 385 у новостей и 470 у
                             списка серверов) на широких окнах между блоками появлялась пустота,
                             а на узких всё сжималось. Теперь доли с ограничениями. -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*" MinWidth="380" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" MinWidth="300" MaxWidth="460" />
                        </Grid.ColumnDefinitions>

                        <!-- Колонка серверов тянется во всю высоту, как и панель новостей справа.
                             Список остаётся у верхнего края (с одним сервером карточка по центру
                             выглядит потерянной), но колонка растянута: карточки идут во всю её
                             ширину, а если серверов станет много — список прокручивается,
                             а не выдавливает нижнюю панель за край окна. -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="ServerSubtitleTextBlock" FontSize="13"
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Text="Получаем статус серверов…" />

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                            <!-- MaxWidth="640" убран: колонка шире 640, и карточки не доставали до
                                 панели новостей — между ними зияла вертикальная полоса фона. -->
                            <ItemsControl x:Name="ServerListPanel" Margin="0,12,0,0" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,12" CornerRadius="18"
                                                Background="{DynamicResource GlassFillBrush}"
                                                BorderThickness="1" Padding="18,14"
                                                Effect="{StaticResource GlassShadow}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource GlassStrokeBrush}" />
                                                    <Style.Triggers>
                                                        <!-- Подсветка карточки под курсором: строка сервера ощущается «живой» -->
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                            <Setter Property="Background" Value="{DynamicResource SoftButtonHoverBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0" VerticalAlignment="Center">
                                                        <Border CornerRadius="9" Background="{DynamicResource CardAltBrush}" Padding="8,3" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{Binding StatusBrush}" />
                                                                <TextBlock Text="{Binding StatusText}" Margin="6,0,0,0" FontSize="10" FontWeight="SemiBold"
                                                                           Foreground="{Binding StatusBrush}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBlock Text="{Binding Detail}" Margin="9,0,0,0" FontSize="11"
                                                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding PlayersText}" FontSize="26" FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding PlayersCaption}" FontSize="10" Margin="0,-1,0,0"
                                                               HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" />
                                                </StackPanel>

                                                <!-- Вход сразу на сервер: показывается только когда сервер
                                                     ответил на пинг, иначе кнопка вела бы в никуда. -->
                                                <Button Grid.Column="2" Margin="16,0,0,0" Width="104"
                                                        VerticalAlignment="Center" Cursor="Hand"
                                                        Style="{StaticResource SoftButton}"
                                                        Click="JoinServerButton_Click"
                                                        Tag="{Binding Host}"
                                                        Content="Играть"
                                                        ToolTip="Запустить игру и сразу подключиться к этому серверу"
                                                        Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <Border Grid.Column="2" VerticalAlignment="Stretch" CornerRadius="24"
                                Background="{DynamicResource GlassFillBrush}" BorderBrush="{DynamicResource GlassStrokeBrush}"
                                BorderThickness="1" Padding="20" Effect="{StaticResource GlassShadow}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Новости" />
                                <Border x:Name="NewsImageBorder" Grid.Row="1" Margin="0,12,0,0" Height="120"
                                        CornerRadius="16" Background="#284136" BorderBrush="#5F8B75" BorderThickness="1" Visibility="Collapsed">
                                    <Image x:Name="NewsImage" Stretch="UniformToFill" />
                                </Border>
                                <TextBlock x:Name="NewsTitleTextBlock" Grid.Row="2" Margin="0,12,0,0" FontSize="14"
                                           FontWeight="SemiBold" TextWrapping="Wrap" Text="Новости загружаются..." />
                                <TextBlock x:Name="NewsDateTextBlock" Grid.Row="3" Margin="0,6,0,0" FontSize="10"
                                           Foreground="{StaticResource MutedBrush}" Text="" />
                                <ScrollViewer Grid.Row="4" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="VerticalOnly">
                                    <!-- Описание рисуется из Markdown: блоки собирает MarkdownRenderer -->
                                    <StackPanel x:Name="NewsDescriptionPanel" />
                                </ScrollViewer>
                                <Button x:Name="OpenNewsButton" Grid.Row="5" Margin="0,12,0,0" Height="36"
                                        Style="{StaticResource SoftButton}" Click="OpenNewsButton_Click"
                                        Content="Открыть новость" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                      </Grid>

                      <!-- ВКЛАДКА «ЛИЧНЫЙ КАБИНЕТ»: профиль со статистикой + ачивки -->
                      <Grid x:Name="AccountPage" Visibility="Collapsed">
                          <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="18" />
                              <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>

                          <ScrollViewer x:Name="AccountScrollViewer" Grid.Column="0"
                                        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                        PreviewMouseWheel="AccountScrollViewer_PreviewMouseWheel">
                              <StackPanel Margin="0,0,6,6">

                                  <!-- КАРТОЧКА ПРОФИЛЯ -->
                                  <Border CornerRadius="24" Background="{DynamicResource GlassFillBrush}"
                                          BorderBrush="{DynamicResource GlassStrokeBrush}" BorderThickness="1"
                                          Padding="26,22" Effect="{StaticResource GlassShadow}">
                                      <StackPanel>
                                          <Grid>
                                              <Grid.ColumnDefinitions>
                                                  <ColumnDefinition Width="Auto" />
                                                  <ColumnDefinition Width="16" />
                                                  <ColumnDefinition Width="*" />
                                                  <ColumnDefinition Width="18" />
                                                  <ColumnDefinition Width="Auto" />
                                              </Grid.ColumnDefinitions>

                                              <!-- СКИН: превью текущего и кнопка смены -->
                                              <StackPanel Grid.Column="4" VerticalAlignment="Top" Width="140">
                                                  <Border Height="132" CornerRadius="14" Padding="8"
                                                          Background="{DynamicResource CardAltBrush}"
                                                          BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                                                      <Grid>
                                                          <TextBlock x:Name="SkinEmptyTextBlock" FontSize="11" TextWrapping="Wrap"
                                                                     TextAlignment="Center" VerticalAlignment="Center"
                                                                     Foreground="{DynamicResource MutedBrush}"
                                                                     Text="Скин не установлен" />
                                                          <Image x:Name="SkinPreviewImage" Stretch="Uniform"
                                                                 RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                                      </Grid>
                                                  </Border>
                                                  <Button x:Name="ChangeSkinButton" Margin="0,10,0,0" Height="36"
                                                          Style="{StaticResource SoftButton}" Click="ChangeSkinButton_Click"
                                                          Content="Сменить скин" ToolTip="Загрузить свой скин" />
                                                  <Button x:Name="ScreenshotsButton" Margin="0,8,0,0" Height="36"
                                                          Style="{StaticResource SoftButton}" Click="ScreenshotsButton_Click"
                                                          Content="Скриншоты" ToolTip="Снимки из игры (F2)" />
                                              </StackPanel>

                                              <!-- Аватар: буква ника, а если скин загружен — его «голова».
                                                   Отступ сверху выравнивает центр аватара по центру поля ника
                                                   (над полем есть подпись «Ник» высотой ~22 px). -->
                                              <Grid Width="62" Height="62" VerticalAlignment="Top" Margin="0,12,0,0">
                                                  <Ellipse Fill="{DynamicResource CardAltBrush}"
                                                           Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" />
                                                  <TextBlock x:Name="ProfileAvatarTextBlock" Text="P" FontSize="26" FontWeight="Bold"
                                                             Foreground="{DynamicResource AccentBrush}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                  <Ellipse x:Name="ProfileAvatarSkinEllipse" Visibility="Collapsed"
                                                           Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                                                           RenderOptions.BitmapScalingMode="NearestNeighbor">
                                                      <Ellipse.Fill>
                                                          <ImageBrush x:Name="ProfileAvatarBrush" Stretch="UniformToFill" />
                                                      </Ellipse.Fill>
                                                  </Ellipse>
                                              </Grid>

                                              <StackPanel Grid.Column="2">
                                                  <TextBlock Text="Ник" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                                                  <!-- Ник + история: на одном компьютере нередко играют двое-трое,
                                                       и раньше ник приходилось перепечатывать руками каждый раз. -->
                                                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0" HorizontalAlignment="Left">
                                                      <TextBox x:Name="UsernameTextBox" Width="300" Text="Player" />
                                                      <Button x:Name="UsernameHistoryButton" Margin="8,0,0,0" Width="34"
                                                              Style="{StaticResource SoftButton}"
                                                              Click="UsernameHistoryButton_Click"
                                                              ToolTip="Недавние ники"
                                                              Content="▾" />
                                                  </StackPanel>
                                                  <TextBlock x:Name="UsernameHintTextBlock" Margin="0,6,0,0" FontSize="11"
                                                             TextWrapping="Wrap"
                                                             Foreground="{DynamicResource MutedBrush}"
                                                             Text="3–16 символов: латиница, цифры, подчёркивание, тире, точка" />
                                                  <TextBlock x:Name="ProfileSummaryTextBlock" Margin="0,10,0,0" FontSize="12"
                                                             TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                                                             Text="Статистика появится после первого запуска игры." />
                                              </StackPanel>
                                          </Grid>

                                          <!-- ПЛИТКИ СТАТИСТИКИ: на всю ширину карточки -->
                                          <ItemsControl x:Name="ProfileStatsPanel" Margin="0,18,0,0">
                                              <ItemsControl.ItemsPanel>
                                                  <ItemsPanelTemplate>
                                                      <WrapPanel />
                                                  </ItemsPanelTemplate>
                                              </ItemsControl.ItemsPanel>
                                              <ItemsControl.ItemTemplate>
                                                  <DataTemplate>
                                                      <Border Width="136" Margin="0,0,10,10" CornerRadius="16" Padding="13,11"
                                                              Background="{DynamicResource CardAltBrush}"
                                                              BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                                                          <StackPanel>
                                                              <TextBlock Text="{Binding Value}" FontSize="22" FontWeight="Bold"
                                                                         Foreground="{DynamicResource AccentBrush}" />
                                                              <TextBlock Text="{Binding Caption}" FontSize="11" Margin="0,2,0,0"
                                                                         Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                                          </StackPanel>
                                                      </Border>
                                                  </DataTemplate>
                                              </ItemsControl.ItemTemplate>
                                          </ItemsControl>

                                          <!-- ГРАФИК ЗА МЕСЯЦ: данные копились и раньше, не хватало формы. -->
                                          <TextBlock x:Name="PlayTimelineHeader" Text="Как играл за месяц" FontSize="13"
                                                     FontWeight="SemiBold" Margin="0,8,0,0" />
                                          <TextBlock x:Name="PlayTimelineCaption" FontSize="11" Margin="0,4,0,0"
                                                     TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
                                          <Border x:Name="PlayTimelineChart" Margin="0,8,0,4" Height="74" CornerRadius="14" Padding="10,8"
                                                  Background="{DynamicResource CardAltBrush}"
                                                  BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                                              <ItemsControl x:Name="PlayTimelinePanel" VerticalAlignment="Bottom">
                                                  <ItemsControl.ItemsPanel>
                                                      <ItemsPanelTemplate>
                                                          <UniformGrid Rows="1" />
                                                      </ItemsPanelTemplate>
                                                  </ItemsControl.ItemsPanel>
                                                  <ItemsControl.ItemTemplate>
                                                      <DataTemplate>
                                                          <Grid Height="58" Margin="1,0" ToolTip="{Binding Tooltip}">
                                                              <!-- Подложка на всю высоту: иначе в пустые дни не за что зацепиться мышью. -->
                                                              <Rectangle Fill="Transparent" />
                                                              <Rectangle VerticalAlignment="Bottom" RadiusX="2" RadiusY="2"
                                                                         Height="{Binding BarHeight}"
                                                                         Fill="{DynamicResource AccentBrush}"
                                                                         Opacity="{Binding BarOpacity}" />
                                                          </Grid>
                                                      </DataTemplate>
                                                  </ItemsControl.ItemTemplate>
                                              </ItemsControl>
                                          </Border>

                                          <!-- ВРЕМЯ ПО СБОРКАМ -->
                                          <TextBlock x:Name="ProfileModpackHeader" Text="Время по сборкам" FontSize="13" FontWeight="SemiBold"
                                                     Margin="0,8,0,0" Visibility="Collapsed" />
                                          <ItemsControl x:Name="ProfileModpackPanel" Margin="0,10,0,0">
                                              <ItemsControl.ItemTemplate>
                                                  <DataTemplate>
                                                      <Grid Margin="0,0,0,10">
                                                          <Grid.ColumnDefinitions>
                                                              <ColumnDefinition Width="*" />
                                                              <ColumnDefinition Width="12" />
                                                              <ColumnDefinition Width="Auto" />
                                                          </Grid.ColumnDefinitions>
                                                          <StackPanel Grid.Column="0">
                                                              <!-- Foreground задан ЯВНО: внутри DataTemplate неявный стиль TextBlock
                                                                   не применяется, и текст оставался цветом по умолчанию — тёмным
                                                                   на тёмной карточке. -->
                                                              <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                                         Foreground="{DynamicResource TextBrush}"
                                                                         TextTrimming="CharacterEllipsis" />
                                                              <ProgressBar Height="5" Margin="0,6,0,0" Minimum="0" Maximum="100"
                                                                           Value="{Binding Percent, Mode=OneWay}"
                                                                           Foreground="{DynamicResource AccentBrush}"
                                                                           Background="{DynamicResource CardAltBrush}"
                                                                           BorderThickness="0" />
                                                          </StackPanel>
                                                          <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="12" FontWeight="SemiBold"
                                                                     VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                                                      </Grid>
                                                  </DataTemplate>
                                              </ItemsControl.ItemTemplate>
                                          </ItemsControl>
                                      </StackPanel>
                                  </Border>

                                  <!-- АЧИВКИ -->
                                  <Border Margin="0,14,0,0" CornerRadius="24" Background="{DynamicResource GlassFillBrush}"
                                          BorderBrush="{DynamicResource GlassStrokeBrush}" BorderThickness="1"
                                          Padding="26,22" Effect="{StaticResource GlassShadow}">
                                      <StackPanel>
                                          <Grid>
                                              <TextBlock Text="Достижения" FontSize="18" FontWeight="Bold" />
                                              <TextBlock x:Name="AchievementsCounterTextBlock" HorizontalAlignment="Right"
                                                         VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                                         Foreground="{DynamicResource MutedBrush}" Text="0 из 0" />
                                          </Grid>

                                          <!-- UniformGrid вместо WrapPanel: карточки фиксированной ширины
                                               оставляли справа пустой хвост до половины блока. Число колонок
                                               считается по ширине в RefreshAchievementColumns. -->
                                          <ItemsControl x:Name="AchievementsPanel" Margin="0,14,0,0"
                                                        SizeChanged="AchievementsPanel_SizeChanged">
                                              <ItemsControl.ItemsPanel>
                                                  <ItemsPanelTemplate>
                                                      <UniformGrid x:Name="AchievementsGrid" Columns="4" />
                                                  </ItemsPanelTemplate>
                                              </ItemsControl.ItemsPanel>
                                              <ItemsControl.ItemTemplate>
                                                  <DataTemplate>
                                                      <Border Margin="0,0,9,9" CornerRadius="16" Padding="13,11"
                                                              Background="{DynamicResource CardAltBrush}"
                                                              BorderBrush="{Binding BorderBrushColor}" BorderThickness="1"
                                                              Opacity="{Binding CardOpacity}"
                                                              ToolTip="{Binding Tooltip}">
                                                          <StackPanel>
                                                              <StackPanel Orientation="Horizontal">
                                                                  <TextBlock Text="{Binding Icon}" FontSize="17" VerticalAlignment="Center"
                                                                             Foreground="{DynamicResource TextBrush}" />
                                                                  <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                                             Margin="8,0,0,0" VerticalAlignment="Center"
                                                                             Foreground="{Binding TitleBrush}"
                                                                             TextTrimming="CharacterEllipsis" />
                                                              </StackPanel>
                                                              <TextBlock Text="{Binding Description}" FontSize="10" Margin="0,6,0,0"
                                                                         Height="26" TextWrapping="Wrap"
                                                                         Foreground="{DynamicResource MutedBrush}" />
                                                              <ProgressBar Height="4" Margin="0,4,0,0" Minimum="0" Maximum="100"
                                                                           Value="{Binding Percent, Mode=OneWay}"
                                                                           Foreground="{Binding TitleBrush}"
                                                                           Background="{DynamicResource StrokeBrush}"
                                                                           BorderThickness="0" />
                                                              <TextBlock Text="{Binding ProgressText}" FontSize="10" Margin="0,5,0,0"
                                                                         Foreground="{DynamicResource MutedBrush}" />
                                                          </StackPanel>
                                                      </Border>
                                                  </DataTemplate>
                                              </ItemsControl.ItemTemplate>
                                          </ItemsControl>
                                      </StackPanel>
                                  </Border>
                              </StackPanel>
                          </ScrollViewer>

                          <!-- Блок «Ссылки» -->
                          <Border Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,6"
                                  CornerRadius="24" Background="{DynamicResource GlassFillBrush}" BorderBrush="{DynamicResource GlassStrokeBrush}"
                                  BorderThickness="1" Padding="18,16" Effect="{StaticResource GlassShadow}">
                              <StackPanel Width="216">
                                  <TextBlock Text="Ссылки" FontSize="13" FontWeight="SemiBold" Margin="2,0,0,0"
                                             Foreground="{DynamicResource MutedBrush}" />

                                  <Button Margin="0,10,0,0" Style="{StaticResource LinkRowButton}" Click="WebsiteButton_Click"
                                          ToolTip="Открыть сайт bl-modern.ru">
                                      <Grid>
                                          <Grid.ColumnDefinitions>
                                              <ColumnDefinition Width="Auto" />
                                              <ColumnDefinition Width="10" />
                                              <ColumnDefinition Width="*" />
                                              <ColumnDefinition Width="Auto" />
                                          </Grid.ColumnDefinitions>
                                          <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource PanelAltBrush}">
                                              <TextBlock Text="🌐" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                          </Border>
                                          <TextBlock Grid.Column="2" Text="Сайт" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                          <TextBlock Grid.Column="3" Text="›" FontSize="17" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource MutedBrush}" />
                                      </Grid>
                                  </Button>

                                  <Button Margin="0,8,0,0" Style="{StaticResource LinkRowButton}" Click="DiscordButton_Click"
                                          ToolTip="Discord-сервер проекта">
                                      <Grid>
                                          <Grid.ColumnDefinitions>
                                              <ColumnDefinition Width="Auto" />
                                              <ColumnDefinition Width="10" />
                                              <ColumnDefinition Width="*" />
                                              <ColumnDefinition Width="Auto" />
                                          </Grid.ColumnDefinitions>
                                          <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource PanelAltBrush}">
                                              <TextBlock Text="💬" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                          </Border>
                                          <TextBlock Grid.Column="2" Text="Discord" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                          <TextBlock Grid.Column="3" Text="›" FontSize="17" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource MutedBrush}" />
                                      </Grid>
                                  </Button>

                                  <Button Margin="0,8,0,0" Style="{StaticResource LinkRowButton}" Click="VkButton_Click"
                                          ToolTip="Группа ВКонтакте">
                                      <Grid>
                                          <Grid.ColumnDefinitions>
                                              <ColumnDefinition Width="Auto" />
                                              <ColumnDefinition Width="10" />
                                              <ColumnDefinition Width="*" />
                                              <ColumnDefinition Width="Auto" />
                                          </Grid.ColumnDefinitions>
                                          <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource PanelAltBrush}">
                                              <TextBlock Text="📢" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                          </Border>
                                          <TextBlock Grid.Column="2" Text="ВКонтакте" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                          <TextBlock Grid.Column="3" Text="›" FontSize="17" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource MutedBrush}" />
                                      </Grid>
                                  </Button>
                              </StackPanel>
                          </Border>
                      </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="FooterTextBlock"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"
                               Text="Готово к работе" />

                    <!-- Ник виден на главной: раньше он был только в кабинете, и игроки заходили как «Player» -->
                    <Button x:Name="UsernameIndicatorButton" Grid.Column="2" Style="{StaticResource LinkRowButton}"
                            Height="34" Click="UsernameIndicator_Click" ToolTip="Изменить ник">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="UsernameIndicatorIcon" Text="👤" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock x:Name="UsernameIndicatorTextBlock" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Text="Ник: Player" />
                            <TextBlock Text="›" Margin="8,0,0,0" FontSize="15" VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedBrush}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ProgressBar x:Name="LauncherProgressBar"
                                 Height="16"
                                 Minimum="0"
                                 Maximum="100"
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource AccentBrush}"
                                 Background="#13211C" />
                    <Button x:Name="PlayButton" Grid.Column="2" Width="220" Style="{StaticResource PrimaryButton}" Click="PlayButton_Click" Content="Играть">
                        <Button.RenderTransform>
                            <ScaleTransform x:Name="PlayButtonScale" ScaleX="1" ScaleY="1" CenterX="110" CenterY="22" />
                        </Button.RenderTransform>
                    </Button>
                </Grid>
            </Grid>
        </Grid>

        <!-- ТОСТ О РАЗБЛОКИРОВКЕ АЧИВКИ: поверх содержимого, кликам не мешает -->
        <Border x:Name="AchievementToast" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,30,104" MinWidth="290" MaxWidth="360" CornerRadius="16" Padding="16,13"
                Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False"
                RenderTransformOrigin="0.5,0.5">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="0" Color="#90000000" Opacity="0.6" />
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="AchievementToastTransform" X="0" Y="20" />
            </Border.RenderTransform>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="13" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="42" Height="42" CornerRadius="21" VerticalAlignment="Center"
                        Background="{DynamicResource CardAltBrush}"
                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                    <TextBlock x:Name="AchievementToastIcon" Text="🏆" FontSize="20"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Достижение получено" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock x:Name="AchievementToastTitle" Text="" FontSize="15" FontWeight="Bold"
                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="AchievementToastDescription" Text="" FontSize="11" Margin="0,3,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>
            </Grid>
        </Border>
        </Grid>
        </Grid>
    </Grid>
</Window>
