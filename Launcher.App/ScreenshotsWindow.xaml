<Window x:Class="Launcher.App.ScreenshotsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Скриншоты"
        Height="640" Width="900"
        MinHeight="480" MinWidth="720"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">

    <!-- Кисти и стили кнопок объявлены здесь же, как и в остальных окнах: они лежат в ресурсах
         КАЖДОГО окна, а не в App.xaml, и StaticResource из чужого окна не виден. Тему поверх них
         кладёт LauncherThemeBrushes.ApplyTheme. -->
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#08110F" />
        <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#F207100E" />
        <SolidColorBrush x:Key="TitleBarBorderBrush" Color="#20372E" />
        <SolidColorBrush x:Key="WindowIconBackgroundBrush" Color="#2B1514" />
        <SolidColorBrush x:Key="WindowIconBorderBrush" Color="#A95B54" />
        <SolidColorBrush x:Key="PanelBrush" Color="#111C19" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#172620" />
        <SolidColorBrush x:Key="CardBrush" Color="#D9111C19" />
        <SolidColorBrush x:Key="CardAltBrush" Color="#CC111C19" />
        <SolidColorBrush x:Key="StrokeBrush" Color="#315245" />
        <SolidColorBrush x:Key="MutedBrush" Color="#B6C8BD" />
        <SolidColorBrush x:Key="TextBrush" Color="#F4F7F1" />
        <SolidColorBrush x:Key="AccentBrush" Color="#D7A84D" />
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#B9802A" />
        <SolidColorBrush x:Key="TextBoxBackgroundBrush" Color="#E008110F" />
        <SolidColorBrush x:Key="TextBoxBorderBrush" Color="#263B33" />
        <SolidColorBrush x:Key="SoftButtonBackgroundBrush" Color="#243B32" />
        <SolidColorBrush x:Key="SoftButtonBorderBrush" Color="#395F4F" />
        <SolidColorBrush x:Key="SoftButtonHoverBrush" Color="#2F4D41" />
        <SolidColorBrush x:Key="SoftButtonPressedBrush" Color="#1D3129" />
        <SolidColorBrush x:Key="TitleBarButtonHoverBrush" Color="#263B33" />
        <SolidColorBrush x:Key="TitleBarButtonPressedBrush" Color="#182821" />
        <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="#F0C76C" />
        <SolidColorBrush x:Key="DangerBrush" Color="#D96B5F" />
        <SolidColorBrush x:Key="TechnicalTextBrush" Color="#D7E2D9" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource TitleBarButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource TitleBarButtonPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SoftButton" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SoftButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SoftButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                CornerRadius="15"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SoftButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SoftButtonPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SoftButton}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
            <Setter Property="Foreground" Value="#1A1307" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource TitleBarBackgroundBrush}"
                BorderBrush="{DynamicResource TitleBarBorderBrush}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="14,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="24" Height="24" CornerRadius="6"
                        Background="{DynamicResource WindowIconBackgroundBrush}"
                        BorderBrush="{DynamicResource WindowIconBorderBrush}"
                        BorderThickness="1" VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Text="◧" />
                </Border>
                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" Text="Скриншоты" />
                <Button Grid.Column="3" Style="{StaticResource TitleBarButton}" Click="CloseButton_Click" Content="×" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="SummaryTextBlock" FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedBrush}" Text="Ищем снимки…" />

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ScreenshotsPanel">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,12,12" CornerRadius="14" Padding="8"
                                    Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                                <StackPanel Width="240">
                                    <Border CornerRadius="10" ClipToBounds="True" Height="135"
                                            Background="#22000000">
                                        <Image Source="{Binding Preview}" Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock Margin="2,8,2,0" FontSize="12" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextBrush}" Text="{Binding FileName}"
                                               ToolTip="{Binding FileName}" />
                                    <TextBlock Margin="2,2,2,0" FontSize="11"
                                               Foreground="{DynamicResource MutedBrush}" Text="{Binding Caption}" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource SoftButton}" Height="30"
                                                Click="OpenScreenshot_Click" Tag="{Binding Path}"
                                                Content="Открыть" />
                                        <Button Grid.Column="2" Style="{StaticResource SoftButton}" Height="30" Width="38"
                                                Click="DeleteScreenshot_Click" Tag="{Binding Path}"
                                                ToolTip="Удалить снимок" Content="✕" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource SoftButton}" Height="36" Padding="16,0"
                        Click="OpenFolder_Click" Content="Открыть папку" />
                <Button Grid.Column="2" Style="{StaticResource SoftButton}" Height="36" Padding="16,0"
                        Click="CloseButton_Click" Content="Закрыть" />
            </Grid>
        </Grid>
    </Grid>
</Window>
