<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Version>1.3.5</Version>
    <!-- Без +git-suffix в ProductVersion: иначе бутстраппер не может распарсить версию и обновляется бесконечно. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>launcher.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <None Update="launcher.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include="launcher.ico">
      <LogicalName>Launcher.App.launcher.ico</LogicalName>
    </EmbeddedResource>
    <Resource Include="background.png" />
    <Resource Include="Sprite-0001.png" />
    <Resource Include="Sprite-0002.png" />
    <!-- servers.dat и modpack-manifest.json переехали в Launcher.Core вместе с кодом,
         который их читает через Assembly.GetExecutingAssembly(). -->
    <EmbeddedResource Include="Screenshots\*.png">
      <LogicalName>Launcher.App.Screenshots.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Screenshots\*.jpg">
      <LogicalName>Launcher.App.Screenshots.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Screenshots\*.jpeg">
      <LogicalName>Launcher.App.Screenshots.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Screenshots\*.webp">
      <LogicalName>Launcher.App.Screenshots.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Launcher.Core\Launcher.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="artifacts\**\*.cs" />
    <EmbeddedResource Remove="artifacts\**\*" />
    <Page Remove="artifacts\**\*" />
    <Resource Remove="artifacts\**\*" />
    <None Remove="artifacts\**\*" />
  </ItemGroup>

</Project>
